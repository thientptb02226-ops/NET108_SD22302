datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id           Int          @id @default(autoincrement())
  roleId       Int          @default(3)
  role         Role         @relation(fields: [roleId], references: [id])
  email        String       @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  carts        Cart[]
  orders       Order[]
  aiSessions   AiSession[]
  auditLogs    AuditLog[]
  quotes       Quote[]
  approvals    AiActionApproval[]
}

model Category {
  id        Int        @id @default(autoincrement())
  parentId  Int?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  name      String
  slug      String     @unique
  icon      String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  products  Product[]
}

model Product {
  id                 Int                    @id @default(autoincrement())
  categoryId         Int
  category           Category               @relation(fields: [categoryId], references: [id])
  name               String
  sku                String                 @unique
  priceMinor         Int
  originalPriceMinor Int?
  stockQuantity      Int                    @default(0)
  description        String?
  specs              String?                // JSON string
  imageUrl           String?
  galleryUrls        String?                // JSON string
  aiTags             String?                // JSON string array
  status             String                 @default("ACTIVE")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  vector             ProductVector?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reservations       InventoryReservation[]
}

model ProductVector {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  embeddingModel  String   @default("text-embedding-3-small")
  embeddingVector String   // JSON array of floats
  metadataJson    String?
  updatedAt       DateTime @default(now())
}

model Cart {
  id          String     @id @default(uuid())
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id])
  sessionId   String?
  totalMinor  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]
  quotes      Quote[]
}

model CartItem {
  id              Int      @id @default(autoincrement())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int      @default(1)
  unitPriceMinor  Int
  createdAt       DateTime @default(now())

  @@unique([cartId, productId])
}

model Quote {
  id             String                 @id @default(uuid())
  customerId     Int
  customer       User                   @relation(fields: [customerId], references: [id])
  cartId         String
  cart           Cart                   @relation(fields: [cartId], references: [id])
  quoteVersion   Int                    @default(1)
  currency       String                 @default("VND")
  subtotalMinor  Int
  discountMinor  Int                    @default(0)
  shippingMinor  Int                    @default(0)
  taxMinor       Int                    @default(0)
  totalMinor     Int
  fingerprint    String
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  orders         Order[]
  reservations   InventoryReservation[]
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  actorId      Int
  operation    String
  requestKey   String
  requestHash  String
  httpStatus   Int?
  responseJson String?  // JSON
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([actorId, operation, requestKey])
}

model InventoryReservation {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  status    String   @default("ACTIVE") // ACTIVE, CONSUMED, RELEASED, EXPIRED
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  quoteId           String?
  quote             Quote?      @relation(fields: [quoteId], references: [id])
  orderCode         String      @unique
  totalMinor        Int
  discountMinor     Int         @default(0)
  shippingMinor     Int         @default(0)
  finalAmountMinor  Int
  status            String      @default("PENDING")
  paymentStatus     String      @default("UNPAID")
  shippingName      String
  shippingPhone     String
  shippingAddress   String
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  payments          Payment[]
  shippingRecord    Shipping?
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceMinor  Int
  subtotalMinor   Int
}

model Payment {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod    String
  transactionId    String?
  amountMinor      Int
  status           String   @default("PAID")
  providerResponse String?  // JSON
  paidAt           DateTime @default(now())
}

model Shipping {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierCode       String    @default("GHN")
  trackingNumber    String    @unique
  shippingStatus    String    @default("READY_TO_PICK")
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
}

model AiSession {
  id             Int      @id @default(autoincrement())
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id])
  sessionToken   String   @unique
  contextSummary String?
  messages       String   @default("[]") // JSON array of {role, content, timestamp}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiActionApproval {
  id          String    @id @default(uuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  agentName   String
  toolName    String
  actionHash  String
  payloadJson String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED, CONSUMED
  expiresAt   DateTime
  decidedBy   Int?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  actorType  String   @default("User")
  action     String
  entityName String?
  entityId   String?
  details    String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())
}
